<Window x:Class="SigstreamTelemetryAgent.Views.Dialogs.ReportBugDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report a bug"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/Icons/SigStream.ico"
        MinWidth="420" MaxWidth="620">
  <Border Padding="16" CornerRadius="12">
    <StackPanel>
      <TextBlock Text="Tell us what went wrong" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="Email (optional)" />
      <TextBox x:Name="EmailBox" Margin="0,4,0,10" />
      <TextBlock Text="Describe the problem" />
      <TextBox x:Name="DescBox" Margin="0,4,0,10" AcceptsReturn="True" Height="140" TextWrapping="Wrap"/>
      <CheckBox x:Name="IncludeLogs" IsChecked="True" Content="Include last 200 lines of logs"/>
      <CheckBox x:Name="IncludeEnv"  IsChecked="True" Content="Include app &amp; OS info"/>

      <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="DarkSlateGray" TextWrapping="Wrap"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True" Width="92" Height="30"/>
        <Button Content="Send" Width="92" Height="30" IsDefault="True" Click="Send_Click"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>