<Page x:Class="SigstreamTelemetryAgent.Views.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="About"
      Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="24" Width="520">
        <TextBlock Text="SigstreamTelemetryAgent" Style="{StaticResource H2}"/>

        <Separator/>

        <TextBlock Text="Preferences" Style="{StaticResource H2}" Margin="0,0,0,8"/>
        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"/>
        <CheckBox Content="Start minimized to tray" IsChecked="{Binding StartMinimized}" Margin="0,6,0,0"/>

        <Separator/>

        <TextBlock Text="Version 0.1" Foreground="{StaticResource MutedBrush}"/>
    </StackPanel>
</Page>
