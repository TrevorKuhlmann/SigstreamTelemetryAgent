<Window  x:Class="SigstreamTelemetryAgent.Views.Pages.AboutPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SigStream Agent" Height="700" Width="1080"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#111520" Padding="16">
            <StackPanel>
                <TextBlock Text="SigStream" FontSize="20" FontWeight="Bold" Margin="0 0 0 12"/>
                <Button Content="Dashboard" Command="{Binding NavigateDashboard}"/>
                <Button Content="COM Port" Command="{Binding NavigateComPort}"/>
                <Button Content="API Config" Command="{Binding NavigateApiConfig}"/>
                <Button Content="About" Command="{Binding NavigateAbout}"/>
            </StackPanel>
        </Border>
        <Frame Grid.Column="1" x:Name="MainFrame"/>
    </Grid>
</Window>