<Page x:Class="SigstreamTelemetryAgent.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:SigstreamTelemetryAgent.Converters"
      xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
      Title="Dashboard"
      Background="{StaticResource SurfaceBrush}">

    <Page.Resources>
        <!-- converters -->
        <conv:LevelToBrushConverter x:Key="LevelToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- local brushes (fallbacks if theme doesn't provide them) -->
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#0F000000"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#E0A800"/>
        <!-- ~15% alpha of WarningBrush for banner background (ARGB: 0x26 = ~15%) -->
        <SolidColorBrush x:Key="WarningBannerBgBrush" Color="#26E0A800"/>

        <!-- High-contrast colors for the registration pill -->
        <SolidColorBrush x:Key="PillGreenBg" Color="#D1FAE5"/>
        <!-- light emerald -->
        <SolidColorBrush x:Key="PillGreenFg" Color="#065F46"/>
        <!-- dark emerald -->
        <SolidColorBrush x:Key="PillRedBg"   Color="#FEE2E2"/>
        <!-- light rose -->
        <SolidColorBrush x:Key="PillRedFg"   Color="#991B1B"/>
        <!-- dark rose -->

        <!-- newest-first activity view -->
        <CollectionViewSource x:Key="ActivityView" Source="{Binding Activity}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="When" Direction="Descending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KPI row -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Registration -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Registration State" Style="{StaticResource H2}"/>

                <!-- pill/badge for state -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <!--<TextBlock Text="State:" Margin="0,0,6,0"/>-->
                    <Border CornerRadius="14" Padding="10,4" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- default = NOT registered -->
                                <Setter Property="Background"  Value="{StaticResource PillRedBg}"/>
                                <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegistered}" Value="True">
                                        <Setter Property="Background"  Value="{StaticResource PillGreenBg}"/>
                                        <Setter Property="BorderBrush" Value="#34D399"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- default = NOT registered -->
                                    <Setter Property="Text"       Value="Not registered"/>
                                    <Setter Property="Foreground" Value="{StaticResource PillRedFg}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRegistered}" Value="True">
                                            <Setter Property="Text"       Value="Registered"/>
                                            <Setter Property="Foreground" Value="{StaticResource PillGreenFg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- device label with context -->
                <TextBlock Text="{Binding DeviceLabel, StringFormat=Device: {0}}"
                           FontFamily="Segoe UI" FontSize="12"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>

            <!-- Cloud heartbeat -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Cloud heartbeat" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Heartbeats:"/>
                    <TextBlock Text="{Binding HeartbeatCounter, Mode=OneWay}" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Offline buffer -->
            <StackPanel Grid.Column="2"
                        ToolTip="If the cloud is unavailable, data is cached locally and flushes automatically once connectivity returns.">
                <TextBlock Text="Offline buffer" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse Width="8" Height="8" Fill="{Binding QueueFillBrush}" Margin="0,6,6,0"/>
                    <TextBlock>
                        <Run Text="{Binding QueueSizeBytes, Mode=OneWay, StringFormat={}{0:N0}}"/>
                        <Run Text=" Bytes  of  "/>
                        <Run Text="{Binding QueueCapacityBytes, Mode=OneWay, StringFormat={}{0:N0}}"/>
                        <Run Text=" Bytes  ( "/>
                        <Run Text="{Binding QueueFillPercent, Mode=OneWay, StringFormat={}{0:0}%}"/>
                        <Run Text=" ) — "/>
                        <Run Text="{Binding QueueStatusText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- separator / offline banner row -->
        <Grid Grid.Row="1" Margin="0,8,0,8">
            <!-- thin separator shown when online -->
            <Separator>
                <Separator.Style>
                    <Style TargetType="Separator">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Separator.Style>
            </Separator>

            <!-- one-line offline banner (shown only when offline) -->
            <Border Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource WarningBannerBgBrush}"
                    Padding="10" CornerRadius="8">
                <DockPanel>
                    <Ellipse Width="10" Height="10" Fill="{StaticResource WarningBrush}"
                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Cloud unreachable — caching data locally."
                               Foreground="{StaticResource WarningBrush}"
                               FontWeight="SemiBold"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Recent activity -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Recent activity" Style="{StaticResource H2}" Margin="0,0,0,6"/>
            <Border Padding="8" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="260">
                    <ItemsControl ItemsSource="{Binding Source={StaticResource ActivityView}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4,0,4">
                                    <Ellipse Width="8" Height="8" Margin="0,4,8,0"
                                             Fill="{Binding Level, Converter={StaticResource LevelToBrushConverter}}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource MutedBrush}"
                                                   Text="{Binding When, StringFormat={}{0:HH:mm:ss}}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Message}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</Page>
