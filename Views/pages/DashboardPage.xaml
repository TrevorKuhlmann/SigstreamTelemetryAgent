<Page x:Class="SigstreamTelemetryAgent.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard">
	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Status cards -->
		<UniformGrid Grid.Row="0" Rows="1" Columns="3" Margin="0,0,0,16">
			<!-- Registration -->
			<Border Padding="16" CornerRadius="8" Background="#111520" BorderBrush="#2A2F3A" BorderThickness="1" Margin="0,0,16,0">
				<StackPanel>
					<TextBlock Text="Registration" FontWeight="Bold" FontSize="14"/>
					<TextBlock Margin="0,6,0,0">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Text" Value="Not registered"/>
								<Setter Property="Foreground" Value="#FFAAAA"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsRegistered}" Value="True">
										<Setter Property="Text" Value="Registered"/>
										<Setter Property="Foreground" Value="#3CE88E"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
					<TextBlock Text="{Binding DeviceLabel}" Opacity="0.8" />
					<TextBlock Text="{Binding MachineId}" Opacity="0.6" FontFamily="Consolas" FontSize="12"/>
				</StackPanel>
			</Border>

			<!-- Heartbeat -->
			<Border Padding="16" CornerRadius="8" Background="#111520" BorderBrush="#2A2F3A" BorderThickness="1" Margin="0,0,16,0">
				<StackPanel>
					<TextBlock Text="Heartbeat" FontWeight="Bold" FontSize="14"/>
					<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
						<Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
							<Ellipse.Style>
								<Style TargetType="Ellipse">
									<Setter Property="Fill" Value="#FF6666"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding LastHeartbeatOk}" Value="True">
											<Setter Property="Fill" Value="#3CE88E"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Ellipse.Style>
						</Ellipse>
						<TextBlock Text="{Binding LastHeartbeatAgo}" />
					</StackPanel>
				</StackPanel>
			</Border>

			<!-- Queue -->
			<Border Padding="16" CornerRadius="8" Background="#111520" BorderBrush="#2A2F3A" BorderThickness="1">
				<StackPanel>
					<TextBlock Text="Offline Queue" FontWeight="Bold" FontSize="14"/>
					<TextBlock Text="{Binding QueueDepth}" FontSize="20" FontWeight="Bold" Margin="0,6,0,4"/>
					<Button Content="Flush now" Width="110" Command="{Binding FlushNow}"/>
				</StackPanel>
			</Border>
		</UniformGrid>

		<!-- You can add charts/logs later in Grid.Row=1 -->
		<Border Grid.Row="1" Padding="16" CornerRadius="8" Background="#0B0E14" BorderBrush="#2A2F3A" BorderThickness="1">
			<TextBlock Text="Recent activity coming soon…" Opacity="0.6"/>
		</Border>
	</Grid>
</Page>
