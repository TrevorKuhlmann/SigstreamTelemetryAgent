<Page x:Class="SigstreamTelemetryAgent.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:SigstreamTelemetryAgent.Converters"
      Title="Dashboard"
      Background="{StaticResource SurfaceBrush}">

    <Page.Resources>
        <conv:LevelToBrushConverter x:Key="LevelToBrushConverter"/>
        <conv:WidthFromPercentConverter x:Key="WidthFromPercentConverter"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#0F000000"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KPI row -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Registration" Style="{StaticResource H2}"/>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBlock Text="State: " />
                    <TextBlock Text="{Binding RegistrationStatusText, Mode=OneWay}"
                               Foreground="{Binding RegistrationStatusBrush, Mode=OneWay}" />
                </StackPanel>

                <!-- Device label instead of MachineId -->
                <TextBlock Text="{Binding DeviceLabel}"
                           FontFamily="Segoe UI" FontSize="12"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Heartbeat" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Heartbeats: " />
                    <TextBlock Text="{Binding HeartbeatCounter, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Offline queue" Style="{StaticResource H2}"/>

                <!-- Count + bytes + Flush -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding QueueDepth}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding QueueSizeBytes, StringFormat={}{0:N0} B}"
                               Margin="8,2,0,0" Foreground="{StaticResource MutedBrush}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Flush now"
                            Command="{Binding FlushNow}" Margin="12,0,0,0" />
                </StackPanel>

                <!-- Linear meter -->
                <Border x:Name="QueueTrack" Height="10" CornerRadius="6"
                        Background="{StaticResource SurfaceBrush}" Margin="0,8,24,0"
                        ToolTip="{Binding QueueFillPercent, StringFormat={}{0:0.0}%}">
                    <Border Background="{Binding QueueFillBrush}" CornerRadius="6" HorizontalAlignment="Left">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource WidthFromPercentConverter}">
                                <Binding ElementName="QueueTrack" Path="ActualWidth"/>
                                <Binding Path="QueueFillPercent"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>
            </StackPanel>
        </Grid>

        <Separator Grid.Row="1"/>

        <!-- Recent activity -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Recent activity" Style="{StaticResource H2}" Margin="0,0,0,8"/>
            <Border Padding="8" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="260">
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4,0,4">
                                    <Ellipse Width="8" Height="8" Margin="0,4,8,0"
                                             Fill="{Binding Level, Converter={StaticResource LevelToBrushConverter}}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource MutedBrush}"
                                                   Text="{Binding When, StringFormat={}{0:HH:mm:ss}}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Message}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</Page>
