<Page x:Class="SigstreamTelemetryAgent.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard"
      Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Minimal KPI row (no tiles) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Registration" Style="{StaticResource H2}"/>
                <TextBlock>
<StackPanel Orientation="Horizontal" Margin="0,4,0,8">
  <TextBlock Text="State: " />
  <TextBlock Text="{Binding RegistrationStatusText, Mode=OneWay}"
             Foreground="{Binding RegistrationStatusBrush, Mode=OneWay}" />
</StackPanel>
                </TextBlock>

                <TextBlock Text="{Binding MachineId}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Heartbeat" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Heartbeats: " />
                    <TextBlock Text="{Binding HeartbeatCounter, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Offline queue" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding QueueDepth}" FontSize="20" FontWeight="Bold"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Flush now" Command="{Binding FlushNow}" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Separator Grid.Row="1"/>

        <!-- Content area hint -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Recent activity" Style="{StaticResource H2}" Margin="0,0,0,8"/>
            <TextBlock Text="Coming soon…" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
    </Grid>
</Page>
