<Page x:Class="SigstreamTelemetryAgent.Views.Pages.ComPortPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="COM Port">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Port:" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ComboBox Width="180" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" />
                    <TextBlock Text="Baud:" Margin="12,0,6,0" VerticalAlignment="Center"/>
                    <TextBox Width="90" Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Refresh" Margin="12,0,0,0" Command="{Binding RefreshPortsCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource PrimaryButton}" Content="Connect"
                  Command="{Binding ConnectCommand}"  Margin="0,0,8,0"/>
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Recent data -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding RecentLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- RX LED -->
                    <Ellipse Width="12" Height="12" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RxPulse}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="RX" Margin="0,0,12,0"/>

                    <!-- TX LED -->
                    <Ellipse Width="12" Height="12" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TxPulse}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="TX" Margin="0,0,16,0"/>

                    <TextBlock Text="Received:"/>
                    <TextBlock Text="{Binding ReceivedCount}" FontWeight="Bold" Margin="6,0,16,0"/>
                    <TextBlock Text="Sent:"/>
                    <TextBlock Text="{Binding SentCount}" FontWeight="Bold" Margin="6,0,16,0"/>
                    <TextBlock Text="Queue:"/>
                    <TextBlock Text="{Binding QueueDepth}" FontWeight="Bold" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Right: connection status -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Disconnected"/>
                                <Setter Property="Foreground" Value="#FFAAAA"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Connected"/>
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>
