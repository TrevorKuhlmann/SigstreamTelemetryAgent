<Page x:Class="SigstreamTelemetryAgent.Views.Pages.ComPortPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="COM Port"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar (no container) -->
        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="180" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"/>

            <TextBlock Text="Baud:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox Width="90" Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- make Refresh consistent with Connect -->
            <Button Style="{StaticResource PrimaryButton}"
            Content="Refresh"
            Command="{Binding RefreshPortsCommand}"
            Margin="12,0,0,0"/>

            <Button Style="{StaticResource PrimaryButton}"
            Content="Connect"
            Command="{Binding ConnectCommand}"
            Margin="12,0,0,0"/>

            <!-- keep it consistent too -->
            <Button Style="{StaticResource PrimaryButton}"
            Content="Disconnect"
            Command="{Binding DisconnectCommand}"
            Margin="12,0,0,0"/>

            <!-- NEW: Clear telemetry -->
            <Button Style="{StaticResource PrimaryButton}"
            Content="Clear"
            Command="{Binding ClearTelemetryCommand}"
            Margin="12,0,0,0"/>
        </StackPanel>


        <Separator Grid.Row="1"/>

        <!-- Data area with subtle boundary for readability -->
        <Border Grid.Row="2"
            BorderBrush="{StaticResource BorderBrush1}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding RecentLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
