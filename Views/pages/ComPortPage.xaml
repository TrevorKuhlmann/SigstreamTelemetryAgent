<!-- Views/Pages/ComPortPage.xaml -->
<Page x:Class="SigstreamTelemetryAgent.Views.Pages.ComPortPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="COM Port">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" >
            <ComboBox Width="180" ItemsSource="{Binding Ports}"/>
            <TextBlock Text="Baud:" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox Width="80" Text="9600"/>
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding RecentLines}"/>
    </Grid>
</Page>