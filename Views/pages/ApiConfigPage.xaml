<Page x:Class="SigstreamTelemetryAgent.Views.Pages.ApiConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="API Config">
    <Grid Margin="24" Width="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="API Registration" FontWeight="Bold" FontSize="16"/>

            <!-- API Key (simple TextBox, no behaviors) -->
            <StackPanel Orientation="Vertical" Margin="0,12,0,0">
                <TextBlock Text="API Key"/>
                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,4,0,8" IsEnabled="{Binding InputsEnabled}"/>
            </StackPanel>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Device Label"/>
                <TextBox Text="{Binding DeviceLabel, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,4,0,8" IsEnabled="{Binding InputsEnabled}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Register" Command="{Binding RegisterCommand}" IsEnabled="{Binding InputsEnabled}" Width="120"/>
                <Button Content="Revoke" Command="{Binding RevokeCommand}" Margin="8,0,0,0" Width="120"/>
            </StackPanel>

            <Border Margin="0,12,0,0" Padding="12" CornerRadius="6" BorderBrush="#2A2F3A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Current device" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MachineId}" FontFamily="Consolas" FontSize="12" Opacity="0.8"/>
                    <TextBlock>
            <Run Text="State: "/>
            <Run>
              <Run.Style>
                <Style TargetType="Run">
                  <Setter Property="Text" Value="Not registered"/>
                  <Setter Property="Foreground" Value="#FFAAAA"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRegistered}" Value="True">
                      <Setter Property="Text" Value="Registered"/>
                      <Setter Property="Foreground" Value="#3CE88E"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Run.Style>
            </Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Separator Margin="0,16,0,12"/>

            <TextBlock Text="Heartbeat" FontWeight="Bold" FontSize="16"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="Send heartbeats" IsChecked="{Binding SendHeartbeats}"/>
                <TextBlock Text="Interval (s):" Margin="16,0,6,0" VerticalAlignment="Center"/>
                <TextBox Width="80" Text="{Binding HeartbeatSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Save" Command="{Binding SaveSettings}" Margin="12,0,0,0" Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
