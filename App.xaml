<Application x:Class="SigstreamTelemetryAgent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar">
    <!-- ADD THIS -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Tray icon resource -->
            <tb:TaskbarIcon x:Key="TrayIcon"
                IconSource="pack://application:,,,/SigstreamTelemetryAgent;component/Resources/Icons/app.png"
                ToolTipText="SigstreamTelemetryAgent">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="TrayOpen_Click"/>
                        <MenuItem Header="Pause Heartbeat" IsCheckable="True"
                Checked="TrayPause_Checked" Unchecked="TrayPause_Unchecked"/>
                        <Separator/>
                        <MenuItem Header="Exit" Click="TrayExit_Click"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

        </ResourceDictionary>
    </Application.Resources>
</Application>
