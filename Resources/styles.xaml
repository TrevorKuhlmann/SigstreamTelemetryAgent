<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand palette (aligned to landing page) -->
    <Color x:Key="BrandBgStart">#07131B</Color>
    <!-- deep navy -->
    <Color x:Key="BrandBgEnd">#0B2F34</Color>
    <!-- teal shadow -->
    <Color x:Key="Panel">#0F1621</Color>
    <Color x:Key="Border">#1E2936</Color>
    <Color x:Key="Text">#F4F7FA</Color>
    <Color x:Key="Subtle">#9FB1C5</Color>

    <!-- Accents from logo/hero -->
    <Color x:Key="AccentBlue">#00B7FF</Color>
    <!-- cyan -->
    <Color x:Key="AccentTeal">#12D7C3</Color>
    <!-- aqua/teal -->
    <Color x:Key="Success">#22E18B</Color>
    <Color x:Key="Warn">#FFC857</Color>
    <Color x:Key="Danger">#FF6B6B</Color>

    <!-- Brushes -->
    <LinearGradientBrush x:Key="AppBgGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandBgStart}" Offset="0"/>
        <GradientStop Color="{StaticResource BrandBgEnd}" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}"/>
    <SolidColorBrush x:Key="BorderBrush1" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource Subtle}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="AccentTealBrush" Color="{StaticResource AccentTeal}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource Warn}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>

    <!-- Base Window/Page -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource AppBgGradient}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style TargetType="Page" BasedOn="{StaticResource {x:Type Window}}"/>

    <!-- Card / Panel -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Buttons -->
    <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentBlue}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentTeal}" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="#101824"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="10"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#0C1420"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}"/>
        <Setter Property="Foreground" Value="#001015"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryButtonBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="#0E1723"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="#0E1723"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- Small status chips -->
    <Style x:Key="Chip" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="CornerRadius" Value="999"/>
    </Style>
</ResourceDictionary>
